# ============================================================
# ResearchCollision environment configuration
# Copy to .env and adjust. NEVER commit .env
# ============================================================

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite by default (created relative to the backend/ working directory)
DATABASE_URL=sqlite:///./data/researchcollision.db

# --- LLM provider -------------------------------------------------
# One of: mock | openrouter | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Literature provider ------------------------------------------
# Primary provider; others are used as automatic fallbacks.
# One of: openalex | semantic_scholar | crossref | arxiv | mock
LITERATURE_PROVIDER=openalex
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=

# --- Embeddings ----------------------------------------------------
# One of: mock | sentence_transformer | openai_compatible
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# sentence_transformer downloads the model on first use. Requires the
# optional dependency: pip install sentence-transformers

# --- Provider tuning -----------------------------------------------
# HTTP timeout for LLM calls (OpenAI-compatible / OpenRouter), seconds.
LLM_TIMEOUT_SECONDS=180
# Max output tokens for structured (agent) LLM calls. Long outputs such as
# the paper draft need headroom; if you see "finish_reason=length" errors,
# raise this.
STRUCTURED_MAX_TOKENS=4096
# Allow literature searches to silently fall back to synthetic (mock) papers.
# DEFAULT (unset/false): synthetic papers are NEVER used unless the whole
# app is in mock mode (no real AI credentials). Real-provider runs fail
# clearly when every real provider fails instead of silently switching to
# fake data. Set true only if you intentionally want the demo fallback.
LITERATURE_ALLOW_MOCK_FALLBACK=false

# --- Limits & security ---------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ACCESS_TOKEN_EXPIRE_MINUTES=720
RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Worker ---------------------------------------------------------
RUN_WORKER_IN_APP=true
WORKER_POLL_INTERVAL_SECONDS=1.0
LITERATURE_TIMEOUT_SECONDS=15

# --- Real-provider configuration (reference) ------------------------
# Uncomment and fill in to run the FULL pipeline with real AI + literature.
# NEVER put real credentials in this file or commit them to git.
#
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_API_KEY=sk-or-...
#
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# LITERATURE_PROVIDER=openalex
# OPENALEX_EMAIL=you@example.org     # polite-usage header (recommended)
# SEMANTIC_SCHOLAR_API_KEY=...
# CROSSREF_EMAIL=you@example.org
#
# EMBEDDING_PROVIDER=sentence_transformer
